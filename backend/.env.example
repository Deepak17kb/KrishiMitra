# ═══════════════════════════════════════════
# KrishiMitra | Backend Environment Variables
# Copy this file to ".env" and fill in your key.
# NEVER share the real .env or push it to GitHub!
# ═══════════════════════════════════════════

# Your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (default is 3000)
PORT=3000

# Environment
NODE_ENV=production
